<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX manifest template; build-msix.ps1 fills in @VERSION@ (four parts) and @PUBLISHER@ (must equal the signing certificate's subject). -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap10 rescap">
  <Identity Name="Perusal.Perusal" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Perusal</DisplayName>
    <PublisherDisplayName>Perusal contributors</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="Perusal" Executable="perusal.exe" uap10:RuntimeBehavior="packagedClassicApp" uap10:TrustLevel="mediumIL">
      <uap:VisualElements DisplayName="Perusal" Description="Review pull requests and merge requests, one batch at a time"
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- perusal:// deep links -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="perusal"><uap:DisplayName>Perusal</uap:DisplayName></uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <!-- a normal desktop app: it runs git and the user's agent CLIs, so it needs full trust -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
